{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SRN headkit manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "inputs"
  ],
  "properties": {
    "render": {},
    "profile": {
      "enum": [
        "pixal-single-v1",
        "pixal-multiview-v1"
      ]
    },
    "alignment": {},
    "matte": {},
    "tone": {},
    "mesh": {},
    "paint": {},
    "ownership": {},
    "palette": {},
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "features": {},
    "fit": {},
    "schemaVersion": {
      "const": 1
    },
    "approval": {
      "type": "object",
      "properties": {
        "appearanceField": {
          "type": "object",
          "required": [
            "decision",
            "geometryInput",
            "geometrySha256",
            "fieldSha256",
            "notes"
          ],
          "additionalProperties": false,
          "properties": {
            "decision": {
              "enum": ["pending", "approved", "rejected"]
            },
            "geometryInput": {
              "enum": ["uvMesh", "repairedMesh", "comfyExport"]
            },
            "geometrySha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "fieldSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "additionalProperties": true
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "camera": {}
  }
}
