root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ps1,psm1}]
indent_style = space
indent_size = 4

[*.json]
indent_style = space
indent_size = 2

[*.cmd]
end_of_line = crlf

[*.set]
charset = unset
end_of_line = crlf
insert_final_newline = unset
trim_trailing_whitespace = false
