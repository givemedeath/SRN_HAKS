//=============================================================================
//
// srn_sky_math.shd -- SRN dynamic skies: procedural sky, clouds, stars, moon,
// aurora, storm lightning, searchlights and a fixed panorama of the land.
//
// Pure functions of the sky direction, the time and the material parameters;
// srn_sky_fs.shd feeds them from the engine. Written for GLSL 1.10: float
// literals only, constant loop bounds, no integer arithmetic.
//
// Textures (material texture0..3):
//   texUnit0 / texUnit1  land panorama, first / second half of the 360 degrees,
//                        RGBA; alpha 1 is land, 0 is open sky.
//   texUnit2 / texUnit3  light masks for the same halves: R window and neon
//                        light, G blinking aircraft-warning beacons.
//
//=============================================================================

#ifndef SRN_SKY_MATH
#define SRN_SKY_MATH

#define SRN_PI 3.14159265
#define SRN_TAU 6.28318531

uniform float SkyPhase;    // 0 dawn, 1 day, 2 dusk, 3 night
uniform vec4 SkyBand;      // x/y elevation (degrees) of the panorama's bottom/top edge, z land haze, w day window dimming
uniform vec4 SkyZenith;    // rgb zenith colour, a sun relighting of the land's faces (texUnit2/3 b, a: normals)
uniform vec4 SkyHorizon;   // rgb horizon colour, a horizon band sharpness
uniform vec4 SkyCloud;     // rgb cloud colour, a cloud opacity
uniform vec4 SkyLand;      // rgb land tint, a land desaturation
uniform vec4 SkySun;       // x azimuth, y elevation (degrees), z disc size, w glow strength
uniform vec4 SkySunColor;  // rgb sun and glow colour, a cloud rim light
uniform vec4 SkyMotion;    // x cloud drift, y coverage, z storm, w lightning
uniform vec4 SkyNight;     // x stars, y moon, z aurora, w city light strength
uniform vec4 SkyExtra;     // x searchlights, y beacons, z city glow on clouds, w rain haze
uniform vec4 SkyGlow;      // rgb colour of the sprawl's light on low clouds, a elevation (degrees) searchlights rise from

//----------------------------------------------------------------------------- noise

float SrnHash1(vec3 p)
{
    // lattice points stay small (the caller wraps them) so the float products below keep their precision
    p = fract(p * 0.1031);
    p += dot(p, p.zyx + 31.32);
    return fract((p.x + p.y) * p.z);
}

vec3 SrnHash3(vec3 p)
{
    return vec3(SrnHash1(p), SrnHash1(p + vec3(19.19, 7.31, 3.77)), SrnHash1(p + vec3(5.13, 31.7, 11.9)));
}

float SrnNoise(vec3 x)
{
    vec3 i = floor(x);
    vec3 f = fract(x);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(mix(SrnHash1(i + vec3(0.0, 0.0, 0.0)), SrnHash1(i + vec3(1.0, 0.0, 0.0)), f.x),
                   mix(SrnHash1(i + vec3(0.0, 1.0, 0.0)), SrnHash1(i + vec3(1.0, 1.0, 0.0)), f.x), f.y),
               mix(mix(SrnHash1(i + vec3(0.0, 0.0, 1.0)), SrnHash1(i + vec3(1.0, 0.0, 1.0)), f.x),
                   mix(SrnHash1(i + vec3(0.0, 1.0, 1.0)), SrnHash1(i + vec3(1.0, 1.0, 1.0)), f.x), f.y), f.z);
}

float SrnFbm(vec3 p)
{
    float sum = 0.0;
    float amp = 0.5;
    for (int i = 0; i < 5; i++)
    {
        sum += amp * SrnNoise(p);
        p = p * 2.03 + vec3(1.7, 9.2, 3.1);
        amp *= 0.5;
    }
    return sum / 0.96875;
}

//----------------------------------------------------------------------------- geometry

// Sphere texture coordinates to a direction: u runs once round the horizon, v from the nadir (0) to the zenith (1).
vec3 SrnSkyDirection(vec2 uv, out float azimuth, out float elevation)
{
    azimuth = uv.x * SRN_TAU;
    elevation = (uv.y - 0.5) * SRN_PI;
    float c = cos(elevation);
    return vec3(c * cos(azimuth), c * sin(azimuth), sin(elevation));
}

vec3 SrnDirectionOf(float azimuthDeg, float elevationDeg)
{
    float a = radians(azimuthDeg);
    float e = radians(elevationDeg);
    return vec3(cos(e) * cos(a), cos(e) * sin(a), sin(e));
}

// Signed smallest difference of two azimuths, radians.
float SrnAngleDiff(float a, float b)
{
    float d = a - b;
    return d - SRN_TAU * floor(d / SRN_TAU + 0.5);
}

//----------------------------------------------------------------------------- panorama

// The land at this direction: rgb, alpha (coverage), light mask (r windows, g beacons, b/a the face's normal to
// the right and up, 0.5 for none), and its colour blurred
// over a few texels (what a lit window is replaced by in daylight).
vec4 SrnLand(vec2 uv, float elevation, out vec4 lights, out vec3 blurred)
{
    float bottom = radians(SkyBand.x);
    float top = radians(SkyBand.y);
    float tv = (elevation - bottom) / (top - bottom);
    lights = vec4(0.0, 0.0, 0.5, 0.5);
    blurred = vec3(0.0);
    if (tv > 1.0)
        return vec4(0.0);
    // the two halves keep continuous coordinates either side of u = 0.5, so mip selection never jumps there
    vec2 ta = vec2(uv.x * 2.0, clamp(tv, 0.002, 0.998));
    vec2 tb = vec2(uv.x * 2.0 - 1.0, ta.y);
    float second = step(0.5, uv.x);
    vec4 land = mix(texture2D(texUnit0, ta), texture2D(texUnit1, tb), second);
    vec4 mask = mix(texture2D(texUnit2, ta), texture2D(texUnit3, tb), second);
    lights = mask;
    blurred = mix(texture2D(texUnit0, ta, 1.5).rgb, texture2D(texUnit1, tb, 1.5).rgb, second);
    if (tv < 0.0)
    {
        // below the panorama: the blurred colour of its bottom row, darkening downward
        vec2 ga = vec2(ta.x, 0.004);
        vec2 gb = vec2(tb.x, 0.004);
        vec3 ground = mix(texture2D(texUnit0, ga, 7.0).rgb, texture2D(texUnit1, gb, 7.0).rgb, second);
        land = vec4(ground * mix(0.7, 0.25, clamp(-tv * 2.0, 0.0, 1.0)), 1.0);
        lights = vec4(0.0, 0.0, 0.5, 0.9);  // the ground faces up
    }
    return land;
}

// Average city light toward this azimuth, from a very blurred mip of the light masks.
float SrnCityGlow(vec2 uv)
{
    vec2 ta = vec2(uv.x * 2.0, 0.3);
    vec2 tb = vec2(uv.x * 2.0 - 1.0, 0.3);
    float second = step(0.5, uv.x);
    return mix(texture2D(texUnit2, ta, 8.0).r, texture2D(texUnit3, tb, 8.0).r, second);
}

//----------------------------------------------------------------------------- sky pieces

// The cloud layer: a flat sheet seen in perspective. Its drift is a slow circle, so the wrap at midnight is seamless.
vec2 SrnCloudPlane(vec3 dir)
{
    return dir.xy / (max(dir.z, 0.0) + 0.06) * 0.55;
}

float SrnCloudField(vec2 p, float dayAngle)
{
    vec2 drift = vec2(cos(dayAngle), sin(dayAngle)) * SkyMotion.x;
    vec3 q = vec3(p + drift, sin(dayAngle * 3.0) * 0.35);
    float n = SrnFbm(q * 1.3);
    return n * 0.7 + 0.3 * SrnFbm(q * 3.4 + vec3(4.0, 2.0, 7.0));
}

vec3 SrnStars(vec3 dir, float timeSeconds)
{
    vec3 q = dir * 150.0;
    vec3 cell = floor(q);
    vec3 h = SrnHash3(cell);
    if (h.x < 0.965)
        return vec3(0.0);
    vec3 centre = cell + 0.25 + 0.5 * SrnHash3(cell + 3.1);
    float d = length(q - centre);
    float size = 0.10 + 0.22 * h.y;
    float star = smoothstep(size, 0.0, d);
    float twinkle = 0.65 + 0.35 * sin(timeSeconds * (1.3 + 3.0 * h.z) + h.y * 40.0);
    vec3 tint = mix(vec3(0.75, 0.85, 1.0), vec3(1.0, 0.85, 0.7), h.z);
    return tint * star * twinkle * (0.4 + 1.6 * (h.x - 0.965) / 0.035);
}

vec3 SrnMoon(vec3 dir, vec3 moonDir, out float cover)
{
    float c = dot(dir, moonDir);
    float r = 0.035;
    float d = acos(clamp(c, -1.0, 1.0));
    cover = smoothstep(r, r * 0.92, d);
    vec3 halo = vec3(0.55, 0.62, 0.8) * (exp(-d * 18.0) * 0.35 + exp(-d * 5.0) * 0.08);
    if (cover <= 0.0)
        return halo;
    vec3 side = normalize(cross(moonDir, vec3(0.0, 0.0, 1.0)));
    vec3 up = cross(side, moonDir);
    vec2 p = vec2(dot(dir - moonDir, side), dot(dir - moonDir, up)) / r;
    float maria = SrnFbm(vec3(p * 2.2, 3.0));
    float limb = sqrt(max(1.0 - dot(p, p), 0.0));
    vec3 surface = vec3(0.92, 0.9, 0.86) * (0.62 + 0.38 * smoothstep(0.35, 0.65, maria)) * (0.55 + 0.45 * limb);
    return mix(halo, surface, cover);
}

// Curtains of the Awakened aurora: thin bright folds that ripple slowly along the sky.
vec3 SrnAurora(vec3 dir, float dayAngle)
{
    if (dir.z < 0.02)
        return vec3(0.0);
    vec3 sum = vec3(0.0);
    for (int i = 0; i < 10; i++)
    {
        float k = float(i) / 10.0;
        float h = 0.18 + k * 0.5;
        vec2 p = dir.xy / (dir.z + h) * 0.9;
        float fold = SrnFbm(vec3(p * 0.9 + vec2(cos(dayAngle * 2.0), sin(dayAngle * 2.0)) * 0.6, k * 0.35 + dayAngle));
        float line = exp(-abs(fold - 0.5) * 38.0);
        vec3 colour = mix(vec3(0.15, 1.0, 0.55), vec3(0.7, 0.25, 1.0), smoothstep(0.25, 0.85, k));
        sum += colour * line * (1.0 - k) * 0.22;
    }
    // from the horizontal direction, not its angle, so the pattern has no break where the angle wraps
    float rays = 0.75 + 0.25 * SrnNoise(vec3(normalize(dir.xy + vec2(1e-5, 0.0)) * 60.0, dayAngle * 40.0));
    return sum * rays * smoothstep(0.02, 0.2, dir.z);
}

// One storm's lightning: a flash in clouds round a random azimuth, and sometimes a forked bolt.
// Returns flash strength in x, bolt light in y.
vec2 SrnLightning(float azimuth, float elevation, float timeSeconds, float cloud)
{
    float slot = floor(timeSeconds * 0.45);
    float local = fract(timeSeconds * 0.45);
    vec3 h = SrnHash3(vec3(slot, 7.0, 3.0));
    if (h.x < 0.45)
        return vec2(0.0);
    float envelope = exp(-local * 9.0) * (0.6 + 0.4 * step(0.5, fract(local * 23.0)));
    envelope += exp(-abs(local - 0.12) * 40.0) * 0.8;
    float a0 = h.y * SRN_TAU;
    float da = SrnAngleDiff(azimuth, a0);
    float flash = envelope * exp(-da * da * 6.0) * (0.35 + 0.65 * cloud);
    float bolt = 0.0;
    if (h.z > 0.4 && elevation < radians(26.0))
    {
        float wobble = (SrnFbm(vec3(elevation * 14.0, slot, 1.0)) - 0.5) * 0.09
                     + (SrnNoise(vec3(elevation * 70.0, slot, 2.0)) - 0.5) * 0.015;
        float x = (da - wobble) * cos(elevation);
        bolt = exp(-abs(x) * 900.0) * envelope * 3.0 + exp(-abs(x) * 120.0) * envelope * 0.4;
    }
    return vec2(flash, bolt);
}

// Searchlight beams climbing from the sprawl's rooftops (SkyGlow.a) and sweeping slowly. A beam stands only where
// the light masks show city at its foot, so none rises from bare mountains.
float SrnSearchlights(float azimuth, float elevation, float timeSeconds)
{
    float rise = elevation - radians(SkyGlow.a);
    if (rise < 0.0)
        return 0.0;
    float sum = 0.0;
    for (int i = 0; i < 8; i++)
    {
        float k = float(i);
        vec3 h = SrnHash3(vec3(k, 41.0, 5.0));
        float base = h.x * SRN_TAU;
        float city = clamp(SrnCityGlow(vec2(base / SRN_TAU, 0.0)) * 10.0, 0.0, 1.0);
        float lean = sin(timeSeconds * (0.08 + 0.07 * h.y) + h.z * 20.0) * 0.55;
        float tilt = radians(55.0 + 25.0 * h.y);
        // azimuth of the beam's axis at this height: it leans sideways as it climbs
        float axis = base + lean * rise / tilt;
        float da = SrnAngleDiff(azimuth, axis) * cos(elevation);
        float width = 0.003 + rise * 0.03;
        float beam = exp(-da * da / (width * width)) * smoothstep(tilt, 0.0, rise) * smoothstep(0.0, 0.004, rise);
        sum += beam * (0.5 + 0.5 * h.z) * city;
    }
    return sum;
}

//----------------------------------------------------------------------------- composition

vec3 SrnSkyColour(vec2 uv, float timeOfDayMs, float dayLengthMs, float weather)
{
    float azimuth;
    float elevation;
    vec3 dir = SrnSkyDirection(uv, azimuth, elevation);
    float seconds = timeOfDayMs / 1000.0;
    float dayAngle = SRN_TAU * timeOfDayMs / dayLengthMs;
    float night = step(2.5, SkyPhase);
    float isDay = step(0.5, SkyPhase) * step(SkyPhase, 1.5);
    float storm = clamp(max(SkyMotion.z, weather), 0.0, 1.0);

    // gradient sky and sun glow
    float up = clamp(dir.z, 0.0, 1.0);
    vec3 sky = mix(SkyHorizon.rgb, SkyZenith.rgb, pow(up, 0.45));
    vec3 sunDir = SrnDirectionOf(SkySun.x, SkySun.y);
    float sunDot = max(dot(dir, sunDir), 0.0);
    float glow = SkySun.w * (pow(sunDot, 6.0) * 0.55 + pow(sunDot, 48.0) * 0.6);
    float band = exp(-max(dir.z, 0.0) * SkyHorizon.a) * SkySun.w * pow(sunDot, 2.0);
    sky += SkySunColor.rgb * (glow + band * 0.7) * (1.0 - storm * 0.7);
    float disc = smoothstep(cos(radians(SkySun.z)), cos(radians(SkySun.z * 0.8)), sunDot);

    // night objects behind the clouds
    vec3 behind = vec3(0.0);
    float moonCover = 0.0;
    if (night > 0.5)
    {
        behind += SrnStars(dir, seconds) * SkyNight.x * smoothstep(0.0, 0.25, dir.z);
        vec3 moonDir = SrnDirectionOf(SkySun.x + 180.0 + 12.0 * sin(dayAngle), 38.0 + 6.0 * cos(dayAngle));
        behind += SrnMoon(dir, moonDir, moonCover) * SkyNight.y;
        behind += SrnAurora(dir, dayAngle) * SkyNight.z;
    }
    behind += SkySunColor.rgb * disc * 2.0 * (1.0 - night) * (1.0 - storm);
    sky += behind;

    // clouds: density from a field threshold, edges facing the sun lit, thick middles darker
    float coverage = clamp(SkyMotion.y + storm * 0.3, 0.0, 0.95);
    float horizonFade = smoothstep(-0.02, 0.16, dir.z);
    vec2 plane = SrnCloudPlane(dir);
    float field = SrnCloudField(plane, dayAngle);
    float threshold = 1.0 - coverage;
    float cloud = smoothstep(threshold - 0.04, threshold + 0.2, field) * horizonFade * SkyCloud.a;
    float thick = smoothstep(threshold + 0.08, threshold + 0.42, field);
    vec2 toSun = normalize(sunDir.xy + vec2(1e-4, 0.0));
    float towardSun = SrnCloudField(plane + toSun * 0.09, dayAngle);
    float edge = clamp(0.5 + (field - towardSun) * 5.0, 0.0, 1.0);
    float broadSun = SkySun.w * (0.25 + 0.75 * pow(sunDot, 3.0));
    vec3 cloudColour = SkyCloud.rgb * (1.0 - 0.5 * thick) * (1.0 - storm * 0.3);
    cloudColour += SkySunColor.rgb * SkySunColor.a * broadSun * (0.25 + 0.75 * edge) * (1.0 - 0.6 * thick);
    // the sprawl lights the undersides of low clouds
    float cityGlow = SrnCityGlow(uv) * SkyExtra.z * exp(-max(dir.z, 0.0) * 3.0);
    cloudColour += SkyGlow.rgb * cityGlow * (0.6 + 0.4 * thick);
    sky += SkyGlow.rgb * cityGlow * 0.2;

    // storm light
    vec2 lightning = vec2(0.0);
    if (SkyMotion.w > 0.0)
    {
        lightning = SrnLightning(azimuth, elevation, seconds, cloud) * SkyMotion.w;
        cloudColour += vec3(0.75, 0.82, 1.0) * lightning.x * 1.4;
        sky += vec3(0.55, 0.6, 0.85) * lightning.x * 0.35;
    }
    sky = mix(sky, cloudColour, cloud);
    sky += vec3(0.85, 0.9, 1.0) * lightning.y;

    // rain haze greys the far sky
    sky = mix(sky, SkyHorizon.rgb * 0.8 + SkyCloud.rgb * 0.2, SkyExtra.w * storm * (1.0 - up * 0.6));
    // streaks from the horizontal direction, not the azimuth, so they have no seam where the azimuth wraps
    float rain = SrnNoise(vec3(normalize(dir.xy + vec2(1e-5, 0.0)) * 260.0, elevation * 9.0 + seconds * 7.0));
    sky += (SkyHorizon.rgb + SkyGlow.rgb * 0.3) * smoothstep(0.72, 1.0, rain) * SkyExtra.w * storm * 0.35;

    // the land
    vec4 lights;
    vec3 blurred;
    vec4 land = SrnLand(uv, elevation, lights, blurred);
    if (land.a > 0.0)
    {
        // by day a lit window takes the colour round it, a little darker, instead of glowing
        vec3 rgb = mix(land.rgb, blurred * 0.9, clamp(lights.r, 0.0, 1.0) * SkyBand.w * isDay);
        float lum = dot(rgb, vec3(0.299, 0.587, 0.114));
        vec3 base = mix(rgb, vec3(lum), SkyLand.a) * SkyLand.rgb;
        // window and neon light: dimmed by day, stronger at night, a slow flicker per block of windows
        float flicker = 0.85 + 0.15 * sin(seconds * (0.7 + 2.0 * SrnHash1(vec3(floor(uv * vec2(900.0, 160.0)), 2.0))));
        float windows = lights.r * mix(1.0, 1.0 - SkyBand.w, isDay);
        base += land.rgb * windows * SkyNight.w * flicker;
        // aircraft beacons blink, each to its own clock
        float phase = SrnHash1(vec3(floor(uv * vec2(1400.0, 240.0)), 9.0));
        float blink = step(0.55, fract(seconds * 0.6 + phase));
        base += vec3(1.0, 0.12, 0.08) * lights.g * blink * SkyExtra.y;
        // the face's normal in the viewer's frame here: x right, y up, z toward the viewer
        vec3 n = vec3(lights.b * 2.0 - 1.0, lights.a * 2.0 - 1.0, 0.0);
        n.z = sqrt(max(1.0 - dot(n.xy, n.xy), 0.0));
        // the sun relights faces turned toward it and shades those turned away
        if (SkyZenith.a > 0.0)
        {
            vec3 toSun = vec3(dot(sunDir.xy, vec2(sin(azimuth), -cos(azimuth))), sunDir.z,
                              -dot(sunDir.xy, vec2(cos(azimuth), sin(azimuth))));
            float facing = dot(n, toSun);
            float shine = SkyZenith.a * smoothstep(-0.08, 0.12, sunDir.z);
            base *= 1.0 + shine * (facing - 0.2) * 0.8;
            base += land.rgb * SkySunColor.rgb * shine * max(facing, 0.0) * 0.35;
        }
        // lightning lights the land, most the faces turned up and toward the viewer
        base += land.rgb * lightning.x * (0.25 + 0.6 * max(n.y, 0.0) + 0.3 * n.z);
        // distance haze, more in rain
        float haze = clamp(SkyBand.z + SkyExtra.w * storm * 0.45, 0.0, 1.0);
        base = mix(base, SkyHorizon.rgb, haze * (1.0 - smoothstep(radians(SkyBand.x), radians(SkyBand.y), elevation) * 0.5));
        base *= 1.0 - weather * 0.35;
        sky = mix(sky, base, land.a);
    }
    // searchlights rise in front of the land behind the city; haze or cloud catches them
    if (SkyExtra.x > 0.0)
        sky += vec3(0.75, 0.85, 1.0) * SrnSearchlights(azimuth, elevation, seconds) * SkyExtra.x
             * (0.35 + 0.65 * max(cloud * (1.0 - land.a), storm * 0.6));
    return max(sky, vec3(0.0));
}

#endif
