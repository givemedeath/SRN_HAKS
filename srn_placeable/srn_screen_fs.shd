//=============================================================================
//
// srn_screen_fs.shd -- fslit with up to four moving screens on the picture.
//
// ScreenBoxN  left, bottom, right, top of a screen, in shares of the picture
//             from its lower left corner; an empty box is none.
// ScreenHowN  x what moves: 1 interface, 2 trace, 3 picture, 4 map, 5 call,
//                6 scan, 7 menu, 8 the lit parts of a panel
//             y how fast, z where in its run it starts (seconds),
//             w how bright it is with no light on it.
//
//=============================================================================

#define SHADER_TYPE 2

#define FOG 1
#define KEYHOLING 1
#define LIGHTING 1

#define NORMAL_MAP 0
#define SPECULAR_MAP 0
#define ROUGHNESS_MAP 0
#define HEIGHT_MAP 0
#define SELF_ILLUMINATION_MAP 0
#define ENVIRONMENT_MAP 0

#include "inc_standard"
#include "srn_screen"

uniform vec4 ScreenBox0;
uniform vec4 ScreenHow0;
uniform vec4 ScreenBox1;
uniform vec4 ScreenHow1;
uniform vec4 ScreenBox2;
uniform vec4 ScreenHow2;
uniform vec4 ScreenBox3;
uniform vec4 ScreenHow3;

vec4 SrnScreen(vec2 uv, vec4 box, vec4 how)
{
    vec2 size = box.zw - box.xy;
    vec2 p = (uv - box.xy) / size;
    float t = SrnSeconds() * how.y + how.z;
    float kind = how.x;
    if (kind > 2.5 && kind < 3.5)
    {
        // a broadcast: a slow drift, grain and now and then a torn line
        float near = 0.9 + 0.05 * sin(t * 0.37);
        vec2 q = (p - 0.5) * near + 0.5 + 0.045 * vec2(sin(t * 0.43), cos(t * 0.31));
        float torn = step(0.97, SrnNoise(vec2(floor(t * 2.0), 5.0))) * step(0.6, SrnNoise(vec2(floor(p.y * 18.0), floor(t * 12.0))));
        q.x += torn * 0.05;
        vec3 seen = texture2D(texUnit0, box.xy + clamp(q, 0.005, 0.995) * size).rgb;
        seen *= 0.94 + 0.12 * SrnNoise(vec2(floor(t * 14.0), floor(p.y * 60.0)));
        return vec4(seen, 1.0);
    }
    vec3 c = texture2D(texUnit0, uv).rgb;
    float high = max(c.r, max(c.g, c.b));
    float low = min(c.r, min(c.g, c.b));
    float light = 1.0;
    float lit = 1.0;
    vec2 m = p - 0.5;
    if (kind < 1.5)
        light = SrnInterface(p, t);
    else if (kind < 2.5)
        light = 0.35 + 1.0 * pow(fract(p.x - t * 0.28), 0.7) + 0.5 * smoothstep(0.985, 1.0, fract(p.x - t * 0.28));
    else if (kind < 4.5)
    {
        float ring = length(m) - fract(t * 0.22) * 0.75;
        light = 1.0 + 1.1 * exp(-ring * ring * 900.0) + 0.35 * step(0.2, c.r - c.b) * sin(t * 4.0) + 0.08 * sin(t * 1.3 + p.x * 9.0);
    }
    else if (kind < 5.5)
        light = 1.0 + 0.35 * sin(length(m) * 24.0 - t * 5.0);
    else if (kind < 6.5)
    {
        float line = p.y - (0.5 + 0.5 * sin(t * 0.8));
        light = 0.92 + 1.2 * exp(-line * line * 700.0) + 0.1 * sin(t * 6.0);
    }
    else if (kind < 7.5)
    {
        float row = floor(p.y * 4.0);
        light = 0.85 + 0.6 * step(abs(row - mod(floor(t * 0.8), 4.0)), 0.1);
    }
    else
    {
        light = SrnInterface(p, t);
        lit = smoothstep(0.2, 0.42, high - low);
    }
    return vec4(c * mix(1.0, max(light, 0.05), lit), lit);
}

bool SrnIn(vec2 uv, vec4 box)
{
    return uv.x > box.x && uv.x < box.z && uv.y > box.y && uv.y < box.w;
}

void main ()
{
    FragmentColor = vec4(1.0);
    SetupStandardShaderInputs();
    vec4 how = vec4(0.0);
    vec4 box = vec4(0.0);
    vec2 uv = fract(vTexCoords);
    if (SrnIn(uv, ScreenBox0)) { box = ScreenBox0; how = ScreenHow0; }
    else if (SrnIn(uv, ScreenBox1)) { box = ScreenBox1; how = ScreenHow1; }
    else if (SrnIn(uv, ScreenBox2)) { box = ScreenBox2; how = ScreenHow2; }
    else if (SrnIn(uv, ScreenBox3)) { box = ScreenBox3; how = ScreenHow3; }
    if (how.x > 0.5)
    {
        vec4 screen = SrnScreen(uv, box, how);
        FragmentColor.rgb = ApplyColorSpace(screen.rgb);
        ApplyStandardShader();
        gl_FragColor = FragmentColor;
        gl_FragColor.rgb = max(gl_FragColor.rgb, min(screen.rgb, vec3(1.0)) * how.w * screen.a);
    }
    else
    {
        ApplyStandardShader();
        gl_FragColor = FragmentColor;
    }
}
